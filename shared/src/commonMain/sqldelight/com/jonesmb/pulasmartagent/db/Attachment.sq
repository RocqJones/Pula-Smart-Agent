CREATE TABLE attachment (
    id            TEXT    NOT NULL PRIMARY KEY,
    survey_id     TEXT    NOT NULL,
    local_path    TEXT    NOT NULL,
    size_bytes    INTEGER NOT NULL,
    created_at    INTEGER NOT NULL,
    upload_status TEXT    NOT NULL,
    retry_count   INTEGER NOT NULL DEFAULT 0,
    last_error    TEXT,

    FOREIGN KEY (survey_id) REFERENCES survey_response(id) ON DELETE CASCADE
);

CREATE INDEX idx_attachment_survey_id
    ON attachment(survey_id);

insert:
INSERT OR REPLACE INTO attachment(id, survey_id, local_path, size_bytes, created_at, upload_status, retry_count, last_error)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

selectBySurveyId:
SELECT * FROM attachment WHERE survey_id = ?;

selectUploaded:
SELECT * FROM attachment WHERE upload_status = 'UPLOADED';

markAsUploaded:
UPDATE attachment SET upload_status = 'UPLOADED', last_error = NULL WHERE id = ?;

markAsFailed:
UPDATE attachment SET upload_status = 'FAILED', last_error = ? WHERE id = ?;

incrementRetry:
UPDATE attachment SET retry_count = retry_count + 1 WHERE id = ?;