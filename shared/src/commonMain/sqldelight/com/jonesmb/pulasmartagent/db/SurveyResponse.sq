CREATE TABLE survey_response (
    id          TEXT    NOT NULL PRIMARY KEY,
    farmer_id   TEXT    NOT NULL,
    created_at  INTEGER NOT NULL,
    status      TEXT    NOT NULL,
    retry_count INTEGER NOT NULL DEFAULT 0,
    last_error  TEXT
);

CREATE INDEX idx_survey_response_status
    ON survey_response(status);

insert:
INSERT OR REPLACE INTO survey_response(id, farmer_id, created_at, status, retry_count, last_error)
VALUES (?, ?, ?, ?, ?, ?);

selectPending:
SELECT * FROM survey_response
WHERE (status = 'PENDING' OR status = 'FAILED')
  AND retry_count < :maxRetry;

selectById:
SELECT * FROM survey_response WHERE id = ?;

updateStatus:
UPDATE survey_response SET status = ?, last_error = NULL WHERE id = ?;

updateStatusWithError:
UPDATE survey_response SET status = ?, last_error = ? WHERE id = ?;

incrementRetry:
UPDATE survey_response SET retry_count = retry_count + 1 WHERE id = ?;

pinRetryToMax:
UPDATE survey_response SET retry_count = ? WHERE id = ?;

